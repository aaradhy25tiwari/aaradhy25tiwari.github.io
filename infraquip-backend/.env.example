# InfraQuip Backend — Environment Variables
# Copy this file to .env and fill in your values

# ── Application ─────────────────────────────────────────────
APP_NAME=InfraQuip API
APP_ENV=development          # development | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1
SECRET_KEY=your-very-secret-key-change-in-production   # openssl rand -hex 32

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/infraquip
# For Supabase: postgresql+asyncpg://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# ── Supabase ─────────────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_STORAGE_BUCKET_MACHINES=machine-images
SUPABASE_STORAGE_BUCKET_DOCUMENTS=machine-documents

# ── Redis (Upstash) ──────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
REDIS_URL=redis://localhost:6379    # local dev alternative

# ── Resend (Email) ────────────────────────────────────────────
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=noreply@infraquip.com
RESEND_FROM_NAME=InfraQuip

# ── Razorpay (Payments) ──────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ── Google Maps ───────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=AIza_your_google_maps_key

# ── CORS ─────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,https://infraquip.com,https://www.infraquip.com

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=100
LOGIN_RATE_LIMIT=5
LOGIN_LOCKOUT_MINUTES=15

# ── JWT ───────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=24
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Cache TTL (seconds) ───────────────────────────────────────
SEARCH_CACHE_TTL=300         # 5 minutes
DASHBOARD_CACHE_TTL=86400    # 24 hours
