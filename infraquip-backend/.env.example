# InfraQuip Backend — Environment Variables
# Copy this file to .env and fill in your values

# ── Application ─────────────────────────────────────────────
APP_NAME=InfraQuip API
APP_ENV=development          # development | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1
SECRET_KEY=your-very-secret-key-change-in-production   # openssl rand -hex 32

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/infraquip
# For Supabase: postgresql+asyncpg://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# ── Supabase ─────────────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_STORAGE_BUCKET_MACHINES=machine-images
SUPABASE_STORAGE_BUCKET_DOCUMENTS=machine-documents

# ── Redis (Upstash) ──────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
REDIS_URL=redis://localhost:6379    # local dev alternative

# ── Email Service (Free Providers: Resend / Gmail SMTP / Brevo) ───
EMAIL_PROVIDER=auto              # "auto" | "resend" | "smtp" | "console"

# Option A: Resend (3,000 free emails/month — https://resend.com)
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=noreply@infraquip.com
RESEND_FROM_NAME=InfraQuip

# Option B: Free SMTP (e.g. Gmail App Password or Brevo / Sendinblue 300 free/day)
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com, SMTP_PASSWORD=your-app-password
# Brevo: SMTP_HOST=smtp-relay.brevo.com, SMTP_PORT=587, SMTP_USER=your-login, SMTP_PASSWORD=your-master-key
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=InfraQuip
SMTP_USE_TLS=true

# ── Razorpay (Payments) ──────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ── Google Maps ───────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=AIza_your_google_maps_key

# ── CORS ─────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,https://infraquip.com,https://www.infraquip.com

# ── Rate Limiting (Tiered & Configurable) ──────────────────────
RATE_LIMIT_DEFAULT=100/minute

# Authentication Routes (Dual Layer: Per-IP & Per-Account Exponential Backoff)
RATE_LIMIT_AUTH_PER_IP=10            # Max auth attempts per IP in window before backoff
RATE_LIMIT_AUTH_PER_ACCOUNT=5        # Max auth attempts per account/email before backoff
AUTH_BACKOFF_WINDOW_SECONDS=60       # Sliding window size for counting attempts
AUTH_BACKOFF_BASE_SECONDS=15         # Level 1 cooldown delay (seconds)
AUTH_BACKOFF_FACTOR=2.0              # Multiplier per escalated breach level
AUTH_BACKOFF_MAX_SECONDS=900         # Maximum cooldown delay cap (15 minutes)

# Public Endpoints
RATE_LIMIT_PUBLIC=60/minute
RATE_LIMIT_SEARCH=30/minute
RATE_LIMIT_PUBLIC_LEADS=30/minute

# Authenticated & Admin Actions
RATE_LIMIT_AUTHENTICATED=180/minute
RATE_LIMIT_ADMIN=300/minute
RATE_LIMIT_CHAT=60/minute
RATE_LIMIT_CHATBOT=20/minute

# ── JWT ───────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=24
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Cache TTL (seconds) ───────────────────────────────────────
SEARCH_CACHE_TTL=300         # 5 minutes
DASHBOARD_CACHE_TTL=86400    # 24 hours
