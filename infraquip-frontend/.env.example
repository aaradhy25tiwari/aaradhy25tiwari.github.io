# InfraQuip Frontend — Environment Variables
# Copy to .env.local and fill in values

# ── Supabase ──────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ── API Backend ────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Production: NEXT_PUBLIC_API_URL=https://api.infraquip.com/api/v1

# ── Google Maps ────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIza_your_google_maps_key

# ── Razorpay (public key only) ─────────────────────────────────
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id

# ── App ────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=InfraQuip
